# Local mode needs no variables file. The recommended Konnect setup is
# make konnect-bootstrap, which generates terraform/konnect.tfvars.
# For a manually provisioned Konnect control plane, use these values instead.
mode                              = "konnect"
kong_cluster_control_plane        = "replace-with-control-plane-host:443"
kong_cluster_server_name          = "replace-with-control-plane-host"
kong_cluster_telemetry_endpoint    = "replace-with-telemetry-host:443"
kong_cluster_telemetry_server_name = "replace-with-telemetry-host"

# Pass TF_VAR_redis_password and configure the same password in the RAG plugin.
# This example does not provision Konnect routes, plugins or document ingestion.
# The defaults point to the certificate files used by bootstrap.
# konnect_cluster_cert_path = "../secrets/konnect-cluster.crt"
# konnect_cluster_key_path  = "../secrets/konnect-cluster.key"
