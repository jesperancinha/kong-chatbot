KONG_RAG_ROUTE=/rag/v1/chat/completions
KONG_SUPPORT_ROUTE=/support/v1/chat/completions
KONG_MODEL=my-gpt
KONG_CONNECT_TIMEOUT=2s
KONG_READ_TIMEOUT=30s
PORT=8080
CHATBOT_PORT=8080
KONG_PROXY_PORT=8000

# Free, fully local mode. Models are downloaded once into a named volume.
KONG_LOCAL_IMAGE=kong:3.9.4
OLLAMA_IMAGE=ollama/ollama:0.13.5
LOCAL_CHAT_MODEL=qwen2.5:1.5b
LOCAL_EMBEDDING_MODEL=nomic-embed-text
LOCAL_READ_TIMEOUT=180s

# Konnect hybrid data plane connection values from the Konnect runtime manager.
KONG_GATEWAY_IMAGE=kong/kong-gateway:3.16.0.1
KONG_CLUSTER_CONTROL_PLANE=replace-with-control-plane-host:443
KONG_CLUSTER_SERVER_NAME=replace-with-control-plane-host
KONG_CLUSTER_TELEMETRY_ENDPOINT=replace-with-telemetry-host:443
KONG_CLUSTER_TELEMETRY_SERVER_NAME=replace-with-telemetry-host

# Set this to a strong local-only value. Configure the same password in the
# Konnect AI RAG Injector Redis vector-database settings.
REDIS_PASSWORD=replace-with-a-long-random-password
